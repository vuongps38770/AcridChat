<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <data>
        <import type="androidx.lifecycle.ViewModelProvider"/>
        <variable
            name="viewModel"
            type="com.example.acrid.viewModel.ChatViewModel" />
    </data>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".View.Fragment.ChatFragment"
        >



        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:id="@+id/progress"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/primary"
            >

            <LinearLayout
                android:id="@+id/linearLayout"
                android:background="@color/gray"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@+id/chatArea"
                app:layout_constraintTop_toTopOf="parent"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@color/bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    >

                    <ImageView
                        android:id="@+id/imgBack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/baseline_arrow_back_ios_24"
                        app:tint="@color/mainChild" />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/avt"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView

                            android:id="@+id/name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Name"
                            android:textColor="@color/mainChild"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/status"
                            android:textColor="@color/gray"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="status" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/seeMore"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/three_dots"
                        app:tint="@color/mainChild"/>
                </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:background="@color/primary"
                        android:scrollIndicators="right"
                        android:id="@+id/recycler"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:clipToPadding="false"
                        />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/chatArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/linearLayout"
                android:orientation="vertical"
                android:background="@drawable/transparent">
                <ImageView
                    android:id="@+id/imgHolder"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:visibility="gone"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/bg">
                    <EditText
                        android:textColor="@color/white"
                        android:id="@+id/edtMessage"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:padding="10dp"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:maxLines="6"
                        android:minLines="1"
                        android:scrollbars="vertical"
                        android:overScrollMode="always"
                        android:text="@={viewModel.message}"

                        android:backgroundTint="@color/mainChild"
                        />
                    <TextView
                        android:textColor="@color/mainChild"
                        android:id="@+id/holder"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:padding="10dp"
                        android:text="Chọn ảnh"
                        android:inputType="textMultiLine"
                        android:gravity="center_vertical|center_horizontal"
                        android:textSize="16dp"
                        />
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:src="@drawable/baseline_image_24"
                        app:tint="@color/mainChild"
                        android:id="@+id/selectImg"/>
                    <ImageButton
                        android:id="@+id/btnSendMessage"
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:src="@drawable/send_icon"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="5dp"
                        android:scaleType="centerInside"
                        android:background="@drawable/transparent"
                        app:tint="@color/mainChild"
                        />
                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/typingStatus"
            android:layout_width="wrap_content"
            android:paddingHorizontal="10dp"
            android:layout_height="20dp"
            android:backgroundTint="@color/bg"
            android:layout_gravity="bottom|left"
            android:layout_marginBottom="45dp"
            android:text="Đang nhập..."
            android:textColor="@color/mainChild"
            android:background="@drawable/top_right_radius"
            android:visibility="gone"/>
    </FrameLayout>
</layout>
