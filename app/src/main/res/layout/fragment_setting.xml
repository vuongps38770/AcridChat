<?xml version="1.0" encoding="utf-8"?>
<layout>
    <data>
        <import type="androidx.lifecycle.ViewModelProvider"/>
        <variable
            name="viewModel"
            type="com.example.acrid.viewModel.SettingViewModel" />
    </data>




    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".View.Fragment.SettingFragment">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/imgAVT"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img"
                        android:layout_marginTop="30dp"
                        />
                    <ImageView
                        android:id="@+id/editImg"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/transparent"
                        android:src="@drawable/image_add_svgrepo_com"
                        android:layout_gravity="bottom|right"/>

                </FrameLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/name"
                    android:text="@{viewModel.name}"
                    android:background="@drawable/transparent"
                    android:gravity="center"
                    android:textSize="20dp"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/status"
                    android:background="@drawable/transparent"
                    android:layout_gravity="center"
                    android:text="@{viewModel.status}"
                    android:layout_marginTop="10dp"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thông tin cá nhân"
                    android:textAllCaps="false"
                    android:drawableStart="@drawable/image_add_svgrepo_com"
                    android:gravity="left|center_vertical"
                    android:drawablePadding="10dp"
                    android:drawableEnd="@drawable/baseline_arrow_back_ios_24"
                    android:background="@drawable/transparent"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/logout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đăng xuất"
                    android:textAllCaps="false"
                    android:drawableStart="@drawable/image_add_svgrepo_com"
                    android:gravity="left|center_vertical"
                    android:drawablePadding="10dp"
                    android:drawableEnd="@drawable/baseline_arrow_back_ios_24"
                    android:background="@drawable/transparent"/>





            </LinearLayout>
        </ScrollView>


    </FrameLayout>
</layout>
