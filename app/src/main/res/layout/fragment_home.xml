<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="androidx.lifecycle.ViewModelProvider"/>
        <variable
            name="viewModel"
            type="com.example.acrid.viewModel.HomeViewModel" />
    </data>



    <FrameLayout
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".View.Fragment.HomeFragment">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <com.google.android.material.appbar.AppBarLayout
                android:backgroundTint="@color/mainChild"
                android:gravity="center"
                android:id="@+id/appbar"
                android:background="@drawable/corner_bottom"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                app:layout_scrollFlags="noScroll|enterAlwaysCollapsed"
                android:paddingHorizontal="20dp"
                >
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:id="@+id/search"
                    android:hint="Tìm kiếm"
                    android:textSize="12dp"
                    android:background="@drawable/search_bar"
                    android:paddingVertical="15sp"
                    android:paddingHorizontal="10dp"
                    android:drawableEnd="@drawable/baseline_search_24"
                    android:drawableTint="@color/mainChild"
                    android:text="@={viewModel.searchQuery}"
                    android:textColorHint="@color/mainChild"
                    android:textColor="@color/mainChild"
                    />
            </com.google.android.material.appbar.AppBarLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:id="@+id/recycler"/>
        </LinearLayout>

    </FrameLayout>


</layout>